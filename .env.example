# Public: canonical public URL, no secret values.
NEXT_PUBLIC_APP_URL=
# Server-only: managed PostgreSQL connection string.
DATABASE_URL=
# Server-only: protects persisted reconstruction requests.
RECONSTRUCTION_WRITE_TOKEN=
# Public read endpoints; optional when SDK defaults are suitable.
NEXT_PUBLIC_SOMNIA_RPC_URL=
DREAMDEX_INDEXER_URL=
SOMNIA_WS_RPC_URL=
# Optional worker configuration. Keep worker persistence server-only.
LIVE_CAPTURE_STALE_AFTER_MS=30000
# Optional, manual-only after verified deployment; never invent an address.
NEXT_PUBLIC_REPLAY_REGISTRY_ADDRESS=
